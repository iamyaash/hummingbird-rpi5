#!/bin/bash
#
# Modified for hummingbird-rpi5 from rpi-bootc-bootloader v0.0.8 by kfox1111
# (https://github.com/kfox1111/rpi-bootc-bootloader, license in LICENSE next to this file).
# The changes are marked "hb1". What changed:
# - With TRYBOOT=0, sync makes the BLS entry that ostree marks "(ostree:0)" the default.
#   That follows bootc rollback, and after finalize-staged it's the new deployment, like
#   before. If no entry or both are marked, it falls back to the old rule with a warning.
#   With TRYBOOT=1 the booted deployment stays the default, as before.
# - Each entry folder is built in bootc/entries/ostree-N.new/ and then swapped in, so files
#   from an older kernel don't stay behind. The non-default folder is done first. A folder
#   that didn't change is left alone.
# - sync and finalize-staged take a lock, because rpi-bootc-bootloader-sync.path can start
#   a sync too. sync runs again if /boot/loader changes while it runs.
# - RPI_BOOTC_* environment variables, used by tests/bootloader/run.sh. The defaults are
#   the same paths and commands as upstream.
# The hb2 changes, for power cuts during a sync:
# - Upstream never flushes the FAT partition until umount, so a power cut in the middle
#   of a sync can leave the FAT table half written and neither entry bootable. Now the
#   FAT is flushed (sync -f) after each new entry folder is written, after each folder
#   swap and after each config file change, so the card only ever holds finished steps.
# - Before mounting, a FAT left dirty by an earlier power cut is repaired with fsck.fat -a.
# - Leftover ostree-N.new folders and *.tmp files from an interrupted sync are removed.
# - A sync that has nothing to change writes nothing to the FAT partition. Entry folders
#   are compared with what they should hold before anything is written (entry_plan and
#   entry_matches replace upstream's process_path), the config files and the trace are
#   built in RAM, and rpi-bootc-log.txt is only rewritten when the sync changed something
#   or failed.

VERSION="v0.0.8-hb2"
WATCHDOG="dtparam=watchdog=on"

# hb1: overrides for the tests. Leave them unset on a Pi.
TMPMNT="${RPI_BOOTC_TMPMNT:-/tmp/mnt}"                # where the FAT partition is mounted
BOOT_DIR="${RPI_BOOTC_BOOT_DIR:-/boot}"               # has loader/entries/ostree-N.conf
SYSROOT="${RPI_BOOTC_SYSROOT:-/sysroot}"              # has ostree/deploy/
PATH_PREFIX="${RPI_BOOTC_PATH_PREFIX:-}"              # put in front of the linux, initrd and ostree= paths
STATUS_JSON="${RPI_BOOTC_STATUS_JSON:-}"              # file to read instead of running bootc status
NO_MOUNT="${RPI_BOOTC_NO_MOUNT:-0}"                   # 1 = TMPMNT is a plain folder, don't mount anything
TRYBOOT_CONF="${RPI_BOOTC_TRYBOOT_CONF:-/etc/rpi-bootc-bootloader/tryboot.conf}"
LOCK_FILE="${RPI_BOOTC_LOCK:-/run/rpi-bootc-bootloader.lock}"
FLUSH_LOG="${RPI_BOOTC_FLUSH_LOG:-}"                  # file that gets one line per FAT flush

show_help() {
	local exit_code="${1:-0}"
	cat <<EOF
Usage: rpi-bootc-bootloader <command> [options]

Commands:
  sync [--tryboot]        Synchronize bootloader configuration with bootc status
                          --tryboot: Enable tryboot mode for safer rollback
                                     Overrides /etc/rpi-bootc-bootloader/tryboot.conf
  tryboot                 Set the tryboot flag for the next reboot
  tryreboot               Set the tryboot flag for the next reboot, and then reboot
  version                 Display version information
  help                    Display this help message

EOF
	exit "$exit_code"
}

show_version() {
	echo "$VERSION"
	exit 0
}

# hb1: only one sync or finalize-staged at a time. The lock is held until the script exits.
take_lock() {
	exec {LOCK_FD}>"$LOCK_FILE" || return 1
	if ! flock -w 120 "$LOCK_FD"; then
		echo "Error: another rpi-bootc-bootloader is still running ($LOCK_FILE)" >&2
		return 1
	fi
}

# hb1: mount, umount and bootc status, with the test overrides.
# hb2: repair a FAT left dirty by a power cut before mounting it. fsck.fat exits 1 when
# it fixed something, which is fine. Anything higher is logged, and the mount still runs.
mount_fat() {
	[ "$NO_MOUNT" = 1 ] && return 0
	if command -v fsck.fat >/dev/null 2>&1; then
		fsck.fat -a "$MNTDEV" >&2
		[ $? -le 1 ] || echo "Warning: fsck.fat -a $MNTDEV failed, mounting anyway" >&2
	else
		echo "Warning: fsck.fat not found, not checking $MNTDEV" >&2
	fi
	mount "$MNTDEV" "$TMPMNT"
}

# hb2: write everything on the FAT partition to the card now. Linux otherwise keeps the
# changes in RAM until umount and writes them in any order, and a power cut in between
# can leave the FAT table pointing at clusters that were never written.
flush_fat() {
	FLUSHED=1
	[ -n "$FLUSH_LOG" ] && echo "$1" >> "$FLUSH_LOG"
	sync -f "$TMPMNT"
}

# hb2: put the contents of stdin in TARGET on the FAT partition, if they differ. The new
# contents go to TARGET.tmp first and are flushed, then renamed over TARGET and flushed
# again, so TARGET is always either the old file or the complete new one. A file that
# didn't change isn't written at all.
write_fat_file() {
	local TARGET="$1"
	local SRC="$WORKDIR/$(basename "$TARGET")"
	cat > "$SRC" || return 1
	if cmp -s "$SRC" "$TARGET"; then
		rm -f "$SRC"
		return 0
	fi
	cp "$SRC" "$TARGET.tmp" || return 1
	rm -f "$SRC"
	flush_fat "write $(basename "$TARGET")" || return 1
	mv "$TARGET.tmp" "$TARGET" || return 1
	flush_fat "rename $(basename "$TARGET")"
}

# hb2: remove what an interrupted sync left on the FAT partition. config-bootc-working.txt
# was upstream's scratch file, now the scratch files are in RAM.
remove_leftovers() {
	local F FOUND=0
	for F in "$TMPMNT"/bootc/entries/ostree-*.new "$TMPMNT"/*.tmp "$TMPMNT"/bootc/entries/*/*.tmp \
		"$TMPMNT"/bootc/entries/*/overlays/*.tmp "$TMPMNT/config-bootc-working.txt"; do
		[ -e "$F" ] || continue
		rm -rf "$F" || return 1
		FOUND=1
	done
	[ "$FOUND" -eq 0 ] || flush_fat "remove leftovers"
}

umount_fat() {
	[ "$NO_MOUNT" = 1 ] && return 0
	umount "$TMPMNT"
}

bootc_status() {
	if [ -n "$STATUS_JSON" ]; then
		cat "$STATUS_JSON"
	else
		bootc status --format json
	fi
}

load_tryboot_config() {
	local config_file="$TRYBOOT_CONF"
	if [ -f "$config_file" ]; then
		# Safely read the config file line by line
		while IFS= read -r line; do
			# Skip comments and empty lines
			case "$line" in
				\#*|'') continue ;;
			esac
			# Check if line starts with TRYBOOT=
			if [ "${line#TRYBOOT=}" != "$line" ]; then
				# Extract value after TRYBOOT= and strip whitespace
				local value="${line#TRYBOOT=}"
				# Simple trim: remove leading/trailing whitespace
				while [ "${value#[[:space:]]}" != "$value" ]; do
					value="${value#[[:space:]]}"
				done
				while [ "${value%[[:space:]]}" != "$value" ]; do
					value="${value%[[:space:]]}"
				done
				# Strict validation: only accept exactly "0" or "1"
				if [ "$value" = "0" ] || [ "$value" = "1" ]; then
					echo "$value"
					return 0
				fi
				# Found TRYBOOT line but invalid value, stop processing
				break
			fi
		done < "$config_file"
	fi
	# Return default value
	echo "0"
}

conf_to_ostree() {
	LOADERFILE="$1"
	OPTIONS=$(grep '^options ' "$LOADERFILE" | sed 's/^options //')
	OSTREE=$(echo "$OPTIONS" | sed 's/.*ostree=\([^ ]*\)/\1/')
	if [ "x$OSTREE" != "x" ]; then
		if [ -d "$PATH_PREFIX$OSTREE" ]; then
			OSTREEPATH=$(readlink -f "$PATH_PREFIX$OSTREE")
			echo "$OSTREEPATH"
			return 0
		fi
	fi
	return 1
}

# hb2: print what entry folder N should contain for the BLS entry LOADERFILE, one line per
# path: "<path in the folder><TAB><source file>", or "<path><TAB>" for a folder.
# cmdline.txt is generated into WORKDIR. Replaces upstream's process_path, which copied
# file by file onto the FAT partition.
entry_plan() {
	local LOADERFILE="$1"

	local OPTIONS=$(grep '^options ' "$LOADERFILE" | sed 's/^options //' || echo "")
	local KERNEL=$(grep '^linux ' "$LOADERFILE" | awk '{print $2}')
	local INITRD=$(grep '^initrd ' "$LOADERFILE" | awk '{print $2}')

	[[ -n "$KERNEL" ]] || { echo "Error: No kernel found in $LOADERFILE" >&2; return 1; }
	[[ -n "$INITRD" ]] || { echo "Error: No initrd found in $LOADERFILE" >&2; return 1; }

	local OSTREE=$(echo "$OPTIONS" | sed 's/.*ostree=\([^ ]*\).*/\1/')
	local OSTREEPATH=""
	if [[ -n "$OSTREE" && -d "$PATH_PREFIX$OSTREE" ]]; then
		OSTREEPATH=$(readlink -f "$PATH_PREFIX$OSTREE")
	fi

	local CMDLINE="$WORKDIR/cmdline.$(basename "$LOADERFILE").txt"
	echo "$OPTIONS" > "$CMDLINE" || return 1

	printf '%s\t%s\n' vmlinuz "$PATH_PREFIX$KERNEL" initrd "$PATH_PREFIX$INITRD" cmdline.txt "$CMDLINE"

	local F
	local DTB_SRC=$(readlink -f "$OSTREEPATH/usr/share/raspberrypi2-kernel"*/*/boot/ 2>/dev/null)
	if [[ -d "$DTB_SRC" ]]; then
		for F in "$DTB_SRC"/*; do
			[[ -f "$F" ]] && printf '%s\t%s\n' "$(basename "$F")" "$(realpath "$F")"
		done
		printf '%s\t\n' overlays
		for F in "$DTB_SRC"/overlays/*; do
			[[ -f "$F" ]] && printf '%s\t%s\n' "overlays/$(basename "$F")" "$(realpath "$F")"
		done
	fi

	local KVER=$(ls "$OSTREEPATH/usr/lib/modules/" | head -n 1)
	local BOOTDIR="$OSTREEPATH/usr/lib/modules/$KVER"
	if [[ -f "$BOOTDIR/rpi-config.txt" ]]; then
		printf '%s\t%s\n' rpi-config.txt "$BOOTDIR/rpi-config.txt"
	fi
}

# hb2: true if folder DEST has exactly what PLAN lists, with the same contents. Checked
# before anything is written, so a folder that didn't change costs no writes to the card.
entry_matches() {
	local DEST="$1" PLAN="$2" REL SRC
	[ -d "$DEST" ] || return 1
	[ "$(cut -f1 "$PLAN" | sort)" == "$(cd "$DEST" && find . -mindepth 1 | sed 's|^\./||' | sort)" ] || return 1
	while IFS=$'\t' read -r REL SRC; do
		if [ -z "$SRC" ]; then
			[ -d "$DEST/$REL" ] || return 1
		else
			cmp -s "$SRC" "$DEST/$REL" || return 1
		fi
	done < "$PLAN"
}

# hb2: copy what PLAN lists into the new folder DIR.
build_entry() {
	local DIR="$1" PLAN="$2" REL SRC
	mkdir -p "$DIR" || return 1
	while IFS=$'\t' read -r REL SRC; do
		if [ -z "$SRC" ]; then
			mkdir -p "$DIR/$REL" || return 1
		else
			mkdir -p "$(dirname "$DIR/$REL")" && cp "$SRC" "$DIR/$REL" || return 1
		fi
	done < "$PLAN"
}

# hb1: build entry folder N in ostree-N.new/, then replace the old folder with it, so
# files the deployment no longer has (DTBs, overlays) don't stay behind. FAT can't swap
# folders atomically, so the old folder is gone for a moment between rm and mv.
# hb2: if the old folder already has the right contents, nothing is written. Otherwise
# the FAT is flushed after the new folder is written and again after the swap.
sync_entry() {
	local N="$1"
	local DEST="$TMPMNT/bootc/entries/ostree-$N"
	local NEW="$DEST.new"
	local PLAN="$WORKDIR/plan.$N"

	entry_plan "$BOOT_DIR/loader/entries/ostree-$N.conf" > "$PLAN" || return 1
	entry_matches "$DEST" "$PLAN" && return 0

	rm -rf "$NEW"
	if ! build_entry "$NEW" "$PLAN"; then
		rm -rf "$NEW"
		return 1
	fi
	flush_fat "write ostree-$N.new" || return 1
	rm -rf "$DEST" || return 1
	mv "$NEW" "$DEST" || return 1
	flush_fat "swap ostree-$N"
}

# hb1: print the number (1 or 2) of the BLS entry that ostree boots by default. ostree
# puts "(ostree:0)" in the title of that entry and "(ostree:1)" in the other one.
# Fails if neither or both entries are marked.
default_entry() {
	local N FOUND=""
	for N in 1 2; do
		if grep -q '^title .*(ostree:0)' "$BOOT_DIR/loader/entries/ostree-$N.conf" 2>/dev/null; then
			[ -z "$FOUND" ] || return 1
			FOUND="$N"
		fi
	done
	[ -n "$FOUND" ] || return 1
	echo "$FOUND"
}

# hb2: the config files are built in RAM and only written to the FAT partition when they
# change, through write_fat_file, so each one is flushed and swapped in whole.
setup_bootloader() {
	BOOTVER="$1"
	OTHERVER="$2"
	write_fat_file "$TMPMNT/tryboot.txt" <<EOF || return 1
[all]
$WATCHDOG
include config-bootc-common.txt

[all]
os_prefix=bootc/entries/ostree-$OTHERVER/
include bootc/entries/ostree-$OTHERVER/rpi-config.txt

[all]
kernel=vmlinuz
initramfs initrd followkernel
EOF
	write_fat_file "$TMPMNT/config-bootc-default.txt" <<EOF || return 1
[all]
os_prefix=bootc/entries/ostree-$BOOTVER/
[gpio6=1]
include bootc/entries/ostree-$BOOTVER/rpi-config.txt
[all]
[gpio6=0]
EOF
	write_fat_file "$TMPMNT/config-bootc-fallback.txt" <<EOF || return 1
os_prefix=bootc/entries/ostree-$OTHERVER/
include bootc/entries/ostree-$OTHERVER/rpi-config.txt
[all]
EOF
	if [ ! -f "$TMPMNT/config.txt" ]; then
		write_fat_file "$TMPMNT/config.txt" <<EOF || return 1
# Do not edit. This is an Automatically generated config file.
# Put your own customization in your image or config-bootc-common.txt

[all]
arm_64bit=1
$WATCHDOG
include config-bootc-common.txt
[all]

# Default boot entry and button check code.
include config-bootc-default.txt

# Include only if config-bootc-default.txt is missing OR if the filter
# [gpio6=0] in config-bootc-default.txt and the fallback button is pressed.
include config-bootc-fallback.txt

[all]
kernel=vmlinuz
initramfs initrd followkernel
EOF
	fi
	if [ ! -f "$TMPMNT/config-bootc-common.txt" ]; then
		write_fat_file "$TMPMNT/config-bootc-common.txt" <<EOF || return 1
# Put your own settings here.
EOF
	fi
}

sync_bootloader() {
	BOOTC_STATUS="$1"
	if [ -z "$BOOTC_STATUS" ]; then
		BOOTC_STATUS=$(bootc_status)
	fi
	if [ "$NO_MOUNT" != 1 ] && [ -z "$MNTDEV" ]; then
		echo "MNTDEV is not defined. Searching for /sysroot..."

		RAW_DEV=$(mount | awk '$3 == "/sysroot" {print $1}')

		if [ -z "$RAW_DEV" ]; then
			echo "Error: Could not find a device mounted at /sysroot." >&2
			exit 1
		fi

		MNTDEV=$(echo "$RAW_DEV" | sed -E 's/[0-9]+$/1/')
	fi
	mkdir -p "$TMPMNT"

	ENTRIES=$(ls "$BOOT_DIR"/loader/entries/ostree-[12].conf | wc -l)

	if [ "x$ENTRIES" != "x1" -a "x$ENTRIES" != "x2" ]; then
		echo "Failed to find any entries" >&2
		exit 1
	fi

	STAGING=$(echo "$BOOTC_STATUS" | jq '.status.staged != null')
	if [ "x$STAGING" != "xtrue" -a "x$STAGING" != "xfalse" ]; then
		echo "Unknown staging state" >&2
		exit 1
	fi

	BOOTED=$(echo "$BOOTC_STATUS" | jq -r '.status.booted.ostree | .checksum + "." + (.deploySerial | tostring)')
	BOOTEDDIR="$SYSROOT/ostree/deploy/default/deploy/$BOOTED"
	if [ "x$BOOTED" == "x.null" -a "$STAGING" == "false" ]; then
		DETECT=$(ls -d "$SYSROOT"/ostree/deploy/default/deploy/*/ 2>/dev/null | wc -l)
		if [ $? -eq 0 -a "x$DETECT" == "x1" -a "x$ENTRIES" == "x1" ]; then
			BOOTEDDIR="$(readlink -f $(ls -d "$SYSROOT"/ostree/deploy/default/deploy/*/))"
		else
			echo "Unknown booted state" >&2
			exit 1
		fi
	fi
	if [ ! -d "$BOOTEDDIR" ]; then
		echo "Couldn't find the booted image dir" >&2
		exit 1
	fi

	echo "Entries: $ENTRIES"

	# hb2: scratch files (config files, cmdline.txt, the trace) go here, in RAM.
	WORKDIR=$(mktemp -d /tmp/rpi-bootc-bootloader.XXXXXX) || exit 1
	MOUNTED=0
	FLUSHED=0

	cleanup() {
		EXIT_CODE=$?
		set +x
		if [[ -n "$BASH_XTRACEFD" ]]; then
			eval "exec ${BASH_XTRACEFD}>&-"
			unset BASH_XTRACEFD
		fi
		# hb2: the trace is written to the card once, at the end, and only if the sync
		# changed something or failed. A sync that changed nothing writes nothing.
		if [ "$MOUNTED" = 1 ] && [ -f "$WORKDIR/trace" ] && [ "$FLUSHED" = 1 -o "$EXIT_CODE" -ne 0 ]; then
			write_fat_file "$TMPMNT/rpi-bootc-log.txt" < "$WORKDIR/trace" || true
		fi
		[ "$MOUNTED" = 1 ] && { umount_fat || true; }
		rm -rf "$WORKDIR"
		exit "$EXIT_CODE"
	}

	trap cleanup EXIT

	mount_fat || exit 1
	MOUNTED=1

	exec {TRACE_FD}> "$WORKDIR/trace"
	export BASH_XTRACEFD="$TRACE_FD"
	set -x

	remove_leftovers || exit 1
	if [ ! -d "$TMPMNT/bootc/entries" ]; then
		mkdir -p "$TMPMNT/bootc/entries" || exit 1
		flush_fat "create bootc/entries" || exit 1
	fi
	if [ "x$ENTRIES" == "x1" ]; then
		DIR=$(conf_to_ostree "$BOOT_DIR/loader/entries/ostree-1.conf")
		test $? -eq 0 || exit 1
		sync_entry 1 || exit 1
		BOOTVER=1
		OTHERVER=1
		NEXTBOOTVER=1
		NEXTOTHERVER=1
		setup_bootloader "$NEXTBOOTVER" "$NEXTOTHERVER" || exit 1
	elif [ "x$ENTRIES" == "x2" ]; then
		DIR1=$(conf_to_ostree "$BOOT_DIR/loader/entries/ostree-1.conf")
		test $? -eq 0 || exit 1
		DIR2=$(conf_to_ostree "$BOOT_DIR/loader/entries/ostree-2.conf")
		test $? -eq 0 || exit 1
		if [ "$BOOTEDDIR" != "$DIR1" -a "$BOOTEDDIR" != "$DIR2" ]; then
			echo "Could not find configuration for our current OS" >&2
			exit 1
		fi
		BOOTVER=1
		OTHERVER=2
		if [ "$BOOTEDDIR" == "$DIR2" ]; then
			BOOTVER=2
			OTHERVER=1
		fi
		NEXTBOOTVER="$BOOTVER"
		NEXTOTHERVER="$OTHERVER"
		# hb1: with TRYBOOT=0, boot what ostree boots by default. After finalize-staged
		# that's the new deployment, after bootc rollback it's the old one.
		# With TRYBOOT=1 keep the booted one as the default and put the other one on
		# tryboot, so a sync after a failed tryboot can't make the untested one the default.
		if [ "$TRYBOOT" -eq 0 ]; then
			if DEFAULTVER=$(default_entry); then
				NEXTBOOTVER="$DEFAULTVER"
				NEXTOTHERVER=$((3 - DEFAULTVER))
			else
				echo "Warning: neither or both BLS entries are marked (ostree:0), using the booted deployment and the staged state instead" >&2
				if [ "$STAGING" == "true" ]; then
					NEXTBOOTVER="$OTHERVER"
					NEXTOTHERVER="$BOOTVER"
				fi
			fi
		fi
		# hb1: rebuild the non-default folder first, then the default one. If the
		# non-default one fails, still fix the default one, then report the failure.
		OTHER_FAILED=0
		if ! sync_entry "$NEXTOTHERVER"; then
			echo "Error: could not update bootc/entries/ostree-$NEXTOTHERVER" >&2
			OTHER_FAILED=1
		fi
		sync_entry "$NEXTBOOTVER" || exit 1
		setup_bootloader "$NEXTBOOTVER" "$NEXTOTHERVER" || exit 1
		if [ "$OTHER_FAILED" -ne 0 ]; then
			exit 1
		fi
	fi
}

# hb1: sync, and sync again if /boot/loader changed while it ran. The .path unit can
# start a sync while ostree is still writing the new loader.N folder, before it swaps
# the /boot/loader link. A try that failed because of the swap is retried too.
# Each try runs in a subshell, so its EXIT trap unmounts.
sync_until_stable() {
	local TRY BEFORE AFTER RC
	for TRY in 1 2 3; do
		BEFORE=$(readlink "$BOOT_DIR/loader")
		( sync_bootloader "" )
		RC=$?
		AFTER=$(readlink "$BOOT_DIR/loader")
		[ "$BEFORE" == "$AFTER" ] && return "$RC"
		echo "$BOOT_DIR/loader changed during sync $TRY, syncing again" >&2
	done
	echo "Error: $BOOT_DIR/loader kept changing during the sync" >&2
	return 1
}

# Main command dispatcher
case "${1:-}" in
	sync)
		shift  # Remove 'sync' from arguments
		# Parse --tryboot flag
		TRYBOOT_ARG=""
		while [ $# -gt 0 ]; do
			case "$1" in
				--tryboot)
					TRYBOOT_ARG="1"
					shift
					;;
				*)
					echo "Error: Unknown option '$1'" >&2
					show_help 1
					;;
			esac
		done

		# Determine TRYBOOT value: CLI flag > config file > default
		if [ -n "$TRYBOOT_ARG" ]; then
			TRYBOOT="$TRYBOOT_ARG"
		else
			TRYBOOT=$(load_tryboot_config)
		fi

		take_lock || exit 1
		sync_until_stable
		exit $?
		;;
        finalize-staged)
		# hb1: wait for a running sync, but finalize the deployment even if the lock
		# can't be taken, so an upgrade is never lost.
		take_lock || echo "Warning: finalizing without the lock" >&2
		if [ "$NO_MOUNT" != 1 ] && [ -z "$MNTDEV" ]; then
			echo "MNTDEV is not defined. Searching for /sysroot..."

			RAW_DEV=$(mount | awk '$3 == "/sysroot" {print $1}')

			if [ -z "$RAW_DEV" ]; then
				echo "Error: Could not find a device mounted at /sysroot." >&2
				exit 1
			fi

			MNTDEV=$(echo "$RAW_DEV" | sed -E 's/[0-9]+$/1/')
		fi
		mkdir -p "$TMPMNT"
		mount_fat || exit 1
		RPI_ENABLED=false
		if [ -f "$TMPMNT/config-bootc-default.txt" ]; then
			RPI_ENABLED=true
		fi
		umount_fat
		BOOTC_STATUS=$(bootc_status)
	        /usr/bin/ostree admin finalize-staged
		#FIXME double check etc is available here.
		TRYBOOT=$(load_tryboot_config)
		if [ "$RPI_ENABLED" == "true" ]; then
			sync_bootloader "$BOOTC_STATUS"
		fi
		;;
	tryboot)
		vcmailbox 0x00038064 4 4 1
		;;
	tryreboot)
		vcmailbox 0x00038064 4 4 1 && reboot
		;;
	version)
		show_version
		;;
	help|--help|-h)
		show_help
		;;
	"")
		echo "Error: No command specified" >&2
		echo "" >&2
		show_help 1
		;;
	*)
		echo "Error: Unknown command '$1'" >&2
		echo "" >&2
		show_help 1
		;;
esac

